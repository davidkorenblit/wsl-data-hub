# Ignore raw data dumps, but track .gitkeep
data/raw/*
!data/raw/.gitkeep

# Track processed team data
!data/teams/

# Jekyll build artifacts
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby
*.gem
Gemfile.lock
vendor/

# Python workflows
__pycache__/
*.py[cod]
.env
.env*
.venv/
venv/

# Local OS files
.DS_Store
Thumbs.db