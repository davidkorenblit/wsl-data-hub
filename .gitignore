# Ignore raw data dumps, but track .gitkeep
data/raw/*
!data/raw/.gitkeep

# Track processed team data
!data/teams/

# Jekyll build artifacts
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby
*.gem
Gemfile.lock
vendor/

# Python workflows
__pycache__/
*.py[cod]
.env
.env*
.venv/
venv/

# Local OS files
.DS_Store
Thumbs.db

# Scratch temp files
scratch_*.json
scratch/

# dbt artifacts and generated secrets
dbt_wsl/profiles.yml
dbt_wsl/target/
dbt_wsl/logs/
dbt_wsl/dbt_packages/
dbt_wsl/.user.yml
